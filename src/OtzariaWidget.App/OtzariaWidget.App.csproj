<Project Sdk="Microsoft.NET.Sdk">

  <!-- One exe, two modes (see Program.cs):
         -RegisterProcessAsComServer  => Widgets Board COM provider (MTA, no UI)
         otherwise                    => WPF settings window (Hebrew, RTL)
       Based on spikes/WidgetSpike (verified working). See docs/research/widget-platform.md -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>OtzariaWidget.App</RootNamespace>
    <AssemblyName>OtzariaWidget</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <UseWinUI>false</UseWinUI>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="1.8.251231004" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="1.8.251216001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="1.8.260921001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OtzariaWidget.Core\OtzariaWidget.Core.csproj" />
    <ProjectReference Include="..\OtzariaWidget.Calendar\OtzariaWidget.Calendar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Templates\**\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Templates" />
  </ItemGroup>

</Project>
