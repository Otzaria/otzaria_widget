<UserControl x:Class="OtzariaWidget.App.SettingsUi.Views.StatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24" MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock Text="מצב" Style="{StaticResource PageTitle}"/>

            <!-- actions -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="רענן" Command="{Binding RefreshCommand}" Margin="0,0,0,0" MinWidth="90"/>
                        <Button Content="פתח את אוצריא" Command="{Binding OpenOtzariaCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="10,0,0,0" MinWidth="130"/>
                        <TextBlock Text="{Binding LastRead}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </WrapPanel>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{Binding Action}" Style="{StaticResource MessageHost}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource StateWarningBrush}" Margin="0,0,0,0"/>
                        <TextBlock Text="{Binding Error, StringFormat='לא ניתן לקרוא את נתוני אוצריא: {0}'}" Style="{StaticResource Secondary}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- detected locations -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="מה זוהה במחשב" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="לא נטען מידע מאוצריא עדיין." Style="{StaticResource Secondary}"
                               Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource StateGlyph}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Style="{StaticResource Body}"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource PathText}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource StateText}" Margin="0,2,0,0"
                                                   Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- counts -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="נתונים שנמצאו" Style="{StaticResource SectionTitle}"/>
                    <UniformGrid Rows="1" Columns="4">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{Binding RecentCount}" Style="{StaticResource Stat}"/>
                            <TextBlock Text="ספרים אחרונים" Style="{StaticResource Secondary}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{Binding BookmarkCount}" Style="{StaticResource Stat}"/>
                            <TextBlock Text="סימניות" Style="{StaticResource Secondary}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{Binding ProgressCount}" Style="{StaticResource Stat}"/>
                            <TextBlock Text="ספרים ב&quot;שמור וזכור&quot;" Style="{StaticResource Secondary}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding SearchCount}" Style="{StaticResource Stat}"/>
                            <TextBlock Text="חיפושים אחרונים" Style="{StaticResource Secondary}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- source status -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="מצב מקורות הנתונים" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource StateGlyph}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource Body}" Margin="0,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource Secondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="פרטי הזיהוי" Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource PathText}" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- help -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="איך מוסיפים את הווידג'טים" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Body}" LineHeight="24">
                        <Run Text="1. לחצו על"/> <Run Text="Win + W" FontWeight="SemiBold"/> <Run Text="כדי לפתוח את לוח הווידג'טים."/>
                        <LineBreak/>
                        <Run Text="2. לחצו על"/> <Run Text="הוסף ווידג'טים" FontWeight="SemiBold"/> <Run Text="(סימן ה-+ בלוח)."/>
                        <LineBreak/>
                        <Run Text="3. בחרו את"/> <Run Text="ווידג'ט אוצריא" FontWeight="SemiBold"/> <Run Text="והוסיפו את הווידג'ט הרצוי."/>
                    </TextBlock>
                    <TextBlock Text="שינויים בהגדרות כאן נשמרים אוטומטית, והווידג'טים מתרעננים מעצמם." Style="{StaticResource Secondary}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
