<UserControl x:Class="OtzariaWidget.App.SettingsUi.Views.DisplayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:OtzariaWidget.App.SettingsUi.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24" MaxWidth="820">
            <TextBlock Text="{l:T 'תצוגה והתנהגות'}" Style="{StaticResource PageTitle}"/>

            <!-- settings-window language -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T 'שפת חלון ההגדרות'}" Style="{StaticResource SectionTitle}"/>
                    <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}"
                              MinWidth="240" HorizontalAlignment="Left" AutomationProperties.Name="{l:T 'שפת חלון ההגדרות'}"/>
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0"
                               Text="{l:T 'השינוי חל מיד. תוכן הווידג\'טים בלוח נשאר בעברית.'}"/>
                </StackPanel>
            </Border>

            <!-- link mode -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T 'פתיחת קישורים'}" Style="{StaticResource SectionTitle}"/>
                    <RadioButton HorizontalAlignment="Left" GroupName="LinkMode" IsChecked="{Binding LinkOpenUrl, Mode=TwoWay}" Content="{l:T 'פתיחה ישירה מהווידג\'ט'}"/>
                    <TextBlock Style="{StaticResource Secondary}" Margin="28,-4,0,8"
                               Text="{l:T 'לוח הווידג\'טים פותח את אוצריא ישירות. הכי מהיר ויציב; מומלץ.'}"/>
                    <RadioButton HorizontalAlignment="Left" GroupName="LinkMode" IsChecked="{Binding LinkProviderLaunch, Mode=TwoWay}" Content="{l:T 'פתיחה דרך שירות הווידג\'ט'}"/>
                    <TextBlock Style="{StaticResource Secondary}" Margin="28,-4,0,0"
                               Text="{l:T 'שירות הווידג\'ט מפעיל את otzaria.exe בעצמו. שימושי אם הפתיחה הישירה נחסמת, ונחוץ במיוחד לגרסה ניידת (דורש נתיב מוגדר לתוכנה). לא פועל כשהמסך נעול.'}"/>
                </StackPanel>
            </Border>

            <!-- privacy -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T 'פרטיות'}" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Content="{l:T 'הסתר חיפושים מהווידג\'טים'}" IsChecked="{Binding HideSearches, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Secondary}" Margin="28,0,0,0"
                               Text="{l:T 'חיפושים אחרונים לא יוצגו באף ווידג\'ט, גם אם הוא מוגדר להציג אותם.'}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
