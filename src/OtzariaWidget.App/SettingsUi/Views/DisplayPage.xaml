<UserControl x:Class="OtzariaWidget.App.SettingsUi.Views.DisplayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24" MaxWidth="820">
            <TextBlock Text="תצוגה והתנהגות" Style="{StaticResource PageTitle}"/>

            <!-- link mode -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="פתיחת קישורים" Style="{StaticResource SectionTitle}"/>
                    <RadioButton HorizontalAlignment="Left" GroupName="LinkMode" IsChecked="{Binding LinkOpenUrl, Mode=TwoWay}" Content="פתיחה ישירה מהווידג'ט"/>
                    <TextBlock Style="{StaticResource Secondary}" Margin="28,-4,0,8"
                               Text="לוח הווידג'טים פותח את אוצריא ישירות. הכי מהיר ויציב; מומלץ."/>
                    <RadioButton HorizontalAlignment="Left" GroupName="LinkMode" IsChecked="{Binding LinkProviderLaunch, Mode=TwoWay}" Content="פתיחה דרך שירות הווידג'ט"/>
                    <TextBlock Style="{StaticResource Secondary}" Margin="28,-4,0,0"
                               Text="שירות הווידג'ט מפעיל את otzaria.exe בעצמו. שימושי אם הפתיחה הישירה נחסמת, ונחוץ במיוחד לגרסה ניידת (דורש נתיב מוגדר לתוכנה). לא פועל כשהמסך נעול."/>
                </StackPanel>
            </Border>

            <!-- privacy -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="פרטיות" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Content="הסתר חיפושים מהווידג'טים" IsChecked="{Binding HideSearches, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Secondary}" Margin="28,0,0,0"
                               Text="חיפושים אחרונים לא יוצגו באף ווידג'ט, גם אם הוא מוגדר להציג אותם."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
