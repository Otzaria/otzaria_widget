{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "rtl": true,
  "body": [
    {
      "type": "Container",
      "$when": "${$host.widgetSize != 'small'}",
      "selectAction": "${if($host.isUserContextAuthenticated == false || action == null, urlAction, action)}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${title}",
                  "weight": "bolder",
                  "wrap": false
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "center",
              "$when": "${headerEnd != ''}",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${headerEnd}",
                  "size": "small",
                  "isSubtle": true,
                  "wrap": false
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${emptyText}",
      "size": "small",
      "isSubtle": true,
      "wrap": true,
      "maxLines": 5,
      "spacing": "small",
      "horizontalAlignment": "center",
      "$when": "${state != 'ok' && $host.widgetSize == 'small'}"
    },
    {
      "type": "TextBlock",
      "text": "${emptyText}",
      "isSubtle": true,
      "wrap": true,
      "maxLines": 4,
      "spacing": "large",
      "horizontalAlignment": "center",
      "$when": "${state != 'ok' && $host.widgetSize != 'small'}"
    },
    {
      "type": "Container",
      "spacing": "small",
      "$when": "${state == 'ok'}",
      "items": [
        {
          "type": "Container",
          "spacing": "small",
          "$data": "${sections}",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "64px",
                  "$when": "${$host.widgetSize != 'small'}",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${lead}",
                      "size": "small",
                      "isSubtle": true,
                      "wrap": false
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "Container",
                      "spacing": "small",
                      "$data": "${lines}",
                      "selectAction": "${if($host.isUserContextAuthenticated == false || action == null, urlAction, action)}",
                      "items": [
                        {
                          "type": "ColumnSet",
                          "columns": [
                            {
                              "type": "Column",
                              "width": "stretch",
                              "items": [
                                {
                                  "type": "TextBlock",
                                  "text": "${text}",
                                  "weight": "${weight}",
                                  "wrap": false
                                }
                              ]
                            },
                            {
                              "type": "Column",
                              "width": "auto",
                              "spacing": "small",
                              "$when": "${meta != ''}",
                              "items": [
                                {
                                  "type": "TextBlock",
                                  "text": "${meta}",
                                  "weight": "${weight}",
                                  "color": "${color}",
                                  "wrap": false
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "TextBlock",
                          "text": "${sub}",
                          "size": "small",
                          "isSubtle": true,
                          "wrap": false,
                          "spacing": "none",
                          "$when": "${sub != ''}"
                        },
                        {
                          "type": "ColumnSet",
                          "spacing": "none",
                          "$when": "${bar != null}",
                          "columns": [
                            {
                              "type": "Column",
                              "width": "auto",
                              "$when": "${bar.fill != ''}",
                              "items": [
                                {
                                  "type": "TextBlock",
                                  "text": "${bar.fill}",
                                  "size": "small",
                                  "color": "${bar.color}",
                                  "wrap": false
                                }
                              ]
                            },
                            {
                              "type": "Column",
                              "width": "auto",
                              "spacing": "none",
                              "$when": "${bar.rest != ''}",
                              "items": [
                                {
                                  "type": "TextBlock",
                                  "text": "${bar.rest}",
                                  "size": "small",
                                  "isSubtle": true,
                                  "wrap": false
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${notice}",
      "size": "small",
      "color": "attention",
      "wrap": true,
      "spacing": "small",
      "$when": "${notice != ''}"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "פתח הגדרות",
      "verb": "settings",
      "$when": "${(state == 'missing' || state == 'error') && $host.isUserContextAuthenticated != false}"
    },
    {
      "type": "Action.OpenUrl",
      "title": "פתח הגדרות",
      "url": "otzaria-widget://settings",
      "$when": "${(state == 'missing' || state == 'error') && $host.isUserContextAuthenticated == false}"
    },
    {
      "type": "Action.Execute",
      "title": "נסה שוב",
      "verb": "refresh",
      "$when": "${state == 'error' && $host.isUserContextAuthenticated != false}"
    }
  ]
}
