{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "rtl": true,
  "body": [
    {
      "type": "Container",
      "$when": "${$host.widgetSize != 'small'}",
      "selectAction": "${if($host.isUserContextAuthenticated == false || action == null, urlAction, action)}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${title}",
                  "weight": "bolder",
                  "wrap": false
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "center",
              "$when": "${headerEnd != ''}",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${headerEnd}",
                  "size": "small",
                  "isSubtle": true,
                  "wrap": false
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${emptyText}",
      "size": "small",
      "isSubtle": true,
      "wrap": true,
      "maxLines": 5,
      "spacing": "small",
      "horizontalAlignment": "center",
      "$when": "${state != 'ok' && $host.widgetSize == 'small'}"
    },
    {
      "type": "TextBlock",
      "text": "${emptyText}",
      "isSubtle": true,
      "wrap": true,
      "maxLines": 4,
      "spacing": "large",
      "horizontalAlignment": "center",
      "$when": "${state != 'ok' && $host.widgetSize != 'small'}"
    },
    {
      "type": "Container",
      "$when": "${state == 'ok' && $host.widgetSize == 'small' && next != null}",
      "selectAction": "${if($host.isUserContextAuthenticated == false || action == null, urlAction, action)}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${next.time}",
          "size": "extraLarge",
          "weight": "bolder",
          "color": "accent",
          "wrap": false
        },
        {
          "type": "TextBlock",
          "text": "${next.name}",
          "weight": "bolder",
          "wrap": true,
          "maxLines": 2,
          "spacing": "none"
        },
        {
          "type": "TextBlock",
          "text": "${next.countdown}",
          "size": "small",
          "isSubtle": true,
          "wrap": false,
          "spacing": "none"
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "none",
      "$when": "${state == 'ok' && $host.widgetSize == 'medium' && next != null}",
      "selectAction": "${if($host.isUserContextAuthenticated == false || action == null, urlAction, action)}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": 5,
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${next.time}",
                  "size": "extraLarge",
                  "weight": "bolder",
                  "color": "accent",
                  "wrap": false
                },
                {
                  "type": "TextBlock",
                  "text": "${next.name}",
                  "weight": "bolder",
                  "wrap": true,
                  "maxLines": 1,
                  "spacing": "none"
                },
                {
                  "type": "TextBlock",
                  "text": "${next.countdown}",
                  "size": "small",
                  "isSubtle": true,
                  "wrap": false,
                  "spacing": "none"
                }
              ]
            },
            {
              "type": "Column",
              "width": 6,
              "spacing": "medium",
              "separator": true,
              "items": [
                {
                  "type": "Container",
                  "spacing": "small",
                  "$data": "${after}",
                  "items": [
                    {
                      "type": "ColumnSet",
                      "columns": [
                        {
                          "type": "Column",
                          "width": "stretch",
                          "items": [
                            {
                              "type": "TextBlock",
                              "text": "${name}",
                              "isSubtle": true,
                              "wrap": false
                            }
                          ]
                        },
                        {
                          "type": "Column",
                          "width": "auto",
                          "items": [
                            {
                              "type": "TextBlock",
                              "text": "${time}",
                              "isSubtle": true,
                              "wrap": false
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "small",
      "$when": "${state == 'ok' && $host.widgetSize == 'large' && count(rows) > 0}",
      "selectAction": "${if($host.isUserContextAuthenticated == false || action == null, urlAction, action)}",
      "items": [
        {
          "type": "Container",
          "spacing": "small",
          "$data": "${rows}",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${name}",
                      "weight": "${weight}",
                      "color": "${color}",
                      "isSubtle": "${past}",
                      "wrap": false
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${time}",
                      "weight": "${weight}",
                      "color": "${color}",
                      "isSubtle": "${past}",
                      "wrap": false
                    }
                  ]
                }
              ]
            },
            {
              "type": "TextBlock",
              "text": "${sub}",
              "size": "small",
              "isSubtle": true,
              "wrap": false,
              "spacing": "none",
              "$when": "${sub != ''}"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "אין זמנים נוספים היום",
      "isSubtle": true,
      "wrap": true,
      "spacing": "large",
      "horizontalAlignment": "center",
      "$when": "${state == 'ok' && next == null && count(rows) == 0}"
    },
    {
      "type": "TextBlock",
      "text": "${notice}",
      "size": "small",
      "color": "attention",
      "wrap": true,
      "spacing": "small",
      "$when": "${notice != ''}"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "פתח הגדרות",
      "verb": "settings",
      "$when": "${(state == 'missing' || state == 'error') && $host.isUserContextAuthenticated != false}"
    },
    {
      "type": "Action.OpenUrl",
      "title": "פתח הגדרות",
      "url": "otzaria-widget://settings",
      "$when": "${(state == 'missing' || state == 'error') && $host.isUserContextAuthenticated == false}"
    },
    {
      "type": "Action.Execute",
      "title": "נסה שוב",
      "verb": "refresh",
      "$when": "${state == 'error' && $host.isUserContextAuthenticated != false}"
    }
  ]
}
