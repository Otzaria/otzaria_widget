{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "rtl": true,
  "body": [
    {
      "type": "TextBlock",
      "text": "${title}",
      "weight": "bolder",
      "wrap": true,
      "maxLines": 2
    },
    {
      "type": "TextBlock",
      "text": "${subtitle}",
      "isSubtle": true,
      "size": "small",
      "wrap": true,
      "spacing": "none",
      "$when": "${subtitle != ''}",
      "maxLines": 3
    },
    {
      "type": "Container",
      "$data": "${fields}",
      "spacing": "small",
      "items": [
        {
          "type": "Input.Toggle",
          "id": "${id}",
          "title": "${label}",
          "value": "${value}",
          "valueOn": "true",
          "valueOff": "false",
          "wrap": true,
          "$when": "${kind == 'toggle'}"
        },
        {
          "type": "Input.ChoiceSet",
          "id": "${id}",
          "label": "${label}",
          "style": "compact",
          "value": "${value}",
          "$when": "${kind == 'choice'}",
          "choices": [
            {
              "$data": "${choices}",
              "title": "${title}",
              "value": "${value}"
            }
          ]
        },
        {
          "type": "Input.ChoiceSet",
          "id": "${id}",
          "label": "${label}",
          "style": "expanded",
          "isMultiSelect": true,
          "value": "${value}",
          "$when": "${kind == 'multi'}",
          "choices": [
            {
              "$data": "${choices}",
              "title": "${title}",
              "value": "${value}"
            }
          ]
        },
        {
          "type": "Input.Number",
          "id": "${id}",
          "label": "${label}",
          "min": "${min}",
          "max": "${max}",
          "value": "${value}",
          "$when": "${kind == 'number'}"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "שמור",
      "verb": "saveSettings"
    },
    {
      "type": "Action.Execute",
      "title": "הגדרות מתקדמות",
      "verb": "settings",
      "associatedInputs": "none",
      "$when": "${settingsButton == true && $host.isUserContextAuthenticated != false}"
    },
    {
      "type": "Action.Execute",
      "title": "ביטול",
      "verb": "exitCustomization",
      "associatedInputs": "none"
    }
  ]
}
