{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "rtl": true,
  "body": [
    {
      "type": "Container",
      "$when": "${$host.widgetSize != 'small'}",
      "selectAction": "${if($host.isUserContextAuthenticated == false || action == null, urlAction, action)}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${title}",
                  "weight": "bolder",
                  "wrap": false
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "center",
              "$when": "${headerEnd != ''}",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${headerEnd}",
                  "size": "small",
                  "isSubtle": true,
                  "wrap": false
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${emptyText}",
      "size": "small",
      "isSubtle": true,
      "wrap": true,
      "maxLines": 5,
      "spacing": "small",
      "horizontalAlignment": "center",
      "$when": "${state != 'ok' && $host.widgetSize == 'small'}"
    },
    {
      "type": "TextBlock",
      "text": "${emptyText}",
      "isSubtle": true,
      "wrap": true,
      "maxLines": 4,
      "spacing": "large",
      "horizontalAlignment": "center",
      "$when": "${state != 'ok' && $host.widgetSize != 'small'}"
    },
    {
      "type": "Container",
      "$when": "${state == 'ok' && $host.widgetSize == 'small' && count(rows) > 0}",
      "selectAction": "${if($host.isUserContextAuthenticated == false || rows[0].action == null, rows[0].urlAction, rows[0].action)}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${rows[0].meta}",
          "size": "extraLarge",
          "weight": "bolder",
          "color": "${if(rows[0].complete, 'good', 'accent')}",
          "wrap": false
        },
        {
          "type": "TextBlock",
          "text": "${rows[0].text}",
          "weight": "bolder",
          "wrap": true,
          "maxLines": 2,
          "spacing": "none"
        },
        {
          "type": "ColumnSet",
          "spacing": "none",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "$when": "${rows[0].bar.fill != ''}",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${rows[0].bar.fill}",
                  "size": "small",
                  "color": "${rows[0].bar.color}",
                  "wrap": false
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "spacing": "none",
              "$when": "${rows[0].bar.rest != ''}",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${rows[0].bar.rest}",
                  "size": "small",
                  "isSubtle": true,
                  "wrap": false
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${state == 'ok' && $host.widgetSize == 'medium' && count(rows) > 0}",
      "items": [
        {
          "type": "Container",
          "spacing": "small",
          "$data": "${rows}",
          "selectAction": "${if($host.isUserContextAuthenticated == false || action == null, urlAction, action)}",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${text}",
                      "wrap": false
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "verticalContentAlignment": "center",
                  "spacing": "small",
                  "$when": "${bar.fill != ''}",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${bar.fill}",
                      "size": "small",
                      "color": "${bar.color}",
                      "wrap": false
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "verticalContentAlignment": "center",
                  "spacing": "none",
                  "$when": "${bar.rest != ''}",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${bar.rest}",
                      "size": "small",
                      "isSubtle": true,
                      "wrap": false
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "verticalContentAlignment": "center",
                  "spacing": "small",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${meta}",
                      "weight": "bolder",
                      "color": "${if(complete, 'good', 'accent')}",
                      "wrap": false
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "small",
      "$when": "${state == 'ok' && $host.widgetSize == 'large' && count(rows) > 0}",
      "items": [
        {
          "type": "Container",
          "spacing": "small",
          "$data": "${rows}",
          "selectAction": "${if($host.isUserContextAuthenticated == false || action == null, urlAction, action)}",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${text}",
                      "wrap": false
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${meta}",
                      "weight": "bolder",
                      "color": "${if(complete, 'good', 'accent')}",
                      "wrap": false
                    }
                  ]
                }
              ]
            },
            {
              "type": "ColumnSet",
              "spacing": "none",
              "columns": [
                {
                  "type": "Column",
                  "width": "auto",
                  "$when": "${bar.fill != ''}",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${bar.fill}",
                      "size": "small",
                      "color": "${bar.color}",
                      "wrap": false
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "spacing": "none",
                  "$when": "${bar.rest != ''}",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${bar.rest}",
                      "size": "small",
                      "isSubtle": true,
                      "wrap": false
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "stretch",
                  "verticalContentAlignment": "center",
                  "spacing": "small",
                  "$when": "${cycle != ''}",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${cycle}",
                      "size": "small",
                      "isSubtle": true,
                      "wrap": false
                    }
                  ]
                }
              ]
            },
            {
              "type": "TextBlock",
              "text": "${sub}",
              "size": "small",
              "isSubtle": true,
              "wrap": false,
              "spacing": "none",
              "$when": "${sub != ''}"
            },
            {
              "type": "ColumnSet",
              "spacing": "none",
              "$data": "${bars}",
              "columns": [
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${label}",
                      "size": "small",
                      "isSubtle": true,
                      "wrap": false
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "spacing": "small",
                  "$when": "${fill != ''}",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${fill}",
                      "size": "small",
                      "color": "${color}",
                      "wrap": false
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "spacing": "none",
                  "$when": "${rest != ''}",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${rest}",
                      "size": "small",
                      "isSubtle": true,
                      "wrap": false
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "stretch",
                  "spacing": "small",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${pct}",
                      "size": "small",
                      "isSubtle": true,
                      "wrap": false
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${note}",
      "size": "small",
      "isSubtle": true,
      "wrap": true,
      "maxLines": 2,
      "spacing": "small",
      "$when": "${note != '' && $host.widgetSize == 'large'}"
    },
    {
      "type": "ColumnSet",
      "spacing": "small",
      "$when": "${pager.show == true && $host.isUserContextAuthenticated != false}",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Execute",
                  "title": "הקודם",
                  "verb": "prev",
                  "isEnabled": "${pager.hasPrev}"
                }
              ]
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${pager.label}",
              "size": "small",
              "isSubtle": true,
              "wrap": false,
              "horizontalAlignment": "center"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "ActionSet",
              "actions": [
                {
                  "type": "Action.Execute",
                  "title": "הבא",
                  "verb": "next",
                  "isEnabled": "${pager.hasNext}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${notice}",
      "size": "small",
      "color": "attention",
      "wrap": true,
      "spacing": "small",
      "$when": "${notice != ''}"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "פתח הגדרות",
      "verb": "settings",
      "$when": "${(state == 'missing' || state == 'error') && $host.isUserContextAuthenticated != false}"
    },
    {
      "type": "Action.OpenUrl",
      "title": "פתח הגדרות",
      "url": "otzaria-widget://settings",
      "$when": "${(state == 'missing' || state == 'error') && $host.isUserContextAuthenticated == false}"
    },
    {
      "type": "Action.Execute",
      "title": "נסה שוב",
      "verb": "refresh",
      "$when": "${state == 'error' && $host.isUserContextAuthenticated != false}"
    }
  ]
}
