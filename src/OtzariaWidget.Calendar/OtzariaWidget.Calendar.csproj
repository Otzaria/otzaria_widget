<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OtzariaWidget.Core\OtzariaWidget.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Kosher.Zmanim marks the "lechumra only" zmanim (alos 26, plag 72/90/120, tzais 120/26 ...) as [Obsolete]; Otzaria still shows them. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned exactly: the package is young (3.1.1, Nov 2026) and the parity tests are a regression test against Otzaria's kosher_dart output. LGPL-2.1: ship Kosher.Zmanim.dll as a separate assembly. -->
    <PackageReference Include="Kosher.Zmanim" Version="[3.1.1]" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OtzariaWidget.Calendar.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\otzaria-cities.json" LogicalName="OtzariaWidget.Calendar.otzaria-cities.json" />
    <EmbeddedResource Include="Data\zmanim-registry.json" LogicalName="OtzariaWidget.Calendar.zmanim-registry.json" />
  </ItemGroup>

</Project>
