<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host simulation harness: plays the role of the Widgets host. It CoCreates the provider (CLSID from the manifest), QIs
       IWidgetProvider/IWidgetProvider2 and drives the callbacks with hand-made WinRT context objects (no projection needed: raw vtables).
       It only works INSIDE the package identity: run it with packaging\run-hostsim.ps1 (Invoke-CommandInDesktopPackage). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HostSim</RootNamespace>
  </PropertyGroup>

</Project>
